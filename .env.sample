# Dapr configuration
# Set DAPR_ENABLED=true to use Dapr conversation API (platform-agnostic)
# Set DAPR_ENABLED=false to use direct Azure OpenAI SDK (legacy mode)
DAPR_ENABLED=true
DAPR_HTTP_PORT=3500

# AI Chat Connection (injected by Radius or set manually)
CONNECTION_AICHAT_ENDPOINT="https://.openai.azure.com/"
CONNECTION_AICHAT_APIKEY=""
CONNECTION_AICHAT_DEPLOYMENT="gpt-4"
CONNECTION_AICHAT_MODEL="gpt-4"
CONNECTION_AICHAT_APIVERSION="2024-02-15-preview"

# AI Embedding Connection (injected by Radius or set manually)
CONNECTION_AIEMBEDDING_ENDPOINT="https://.openai.azure.com/"
CONNECTION_AIEMBEDDING_APIKEY=""
CONNECTION_AIEMBEDDING_DEPLOYMENT="text-embedding-3-small"
CONNECTION_AIEMBEDDING_MODEL="text-embedding-3-small"
CONNECTION_AIEMBEDDING_APIVERSION="2024-02-15-preview"

# SQL Server Connection (injected by Radius or set manually)
CONNECTION_SQLSERVERDB_CONNECTIONSTRING="Server=.database.windows.net;Database=;Authentication=Active Directory Default;Connection Timeout=90;"
MSSQL_TABLE_NAME="ChatMemories"
