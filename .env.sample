# AI Model Configuration
# These environment variables are automatically populated by Radius when deploying via app.bicep
# For local development without Radius, you can set them manually in a .env file

# Azure OpenAI Configuration (when deploying to Azure with Radius)
CONNECTION_AICHAT_ENDPOINT="https://<your-resource>.openai.azure.com/"
CONNECTION_AICHAT_APIKEY=""
CONNECTION_AIEMBEDDING_ENDPOINT="https://<your-resource>.openai.azure.com/"
CONNECTION_AIEMBEDDING_APIKEY=""
CONNECTION_AIEMBEDDING_DEPLOYMENT="text-embedding-3-small"
CONNECTION_AICHAT_DEPLOYMENT="gpt-4"

# Local llama.cpp Configuration (when deploying to Kubernetes/k3d with Radius)
# Radius will automatically set these when using the kubernetes recipe
# CONNECTION_AICHAT_ENDPOINT="http://llama-chat-xxxxx.default.svc.cluster.local:80/v1"
# CONNECTION_AICHAT_APIKEY=""
# CONNECTION_AIEMBEDDING_ENDPOINT="http://llama-embedding-xxxxx.default.svc.cluster.local:80/v1"
# CONNECTION_AIEMBEDDING_APIKEY=""
# CONNECTION_AIEMBEDDING_DEPLOYMENT="nomic-embed-text"
# CONNECTION_AICHAT_DEPLOYMENT="llama-3.1-8b-instruct"

# Database Configuration
CONNECTION_SQLSERVERDB_CONNECTIONSTRING="Server=<server>.database.windows.net;Database=<db>;Authentication=Active Directory Default;Connection Timeout=90;"
MSSQL_TABLE_NAME="ChatMemories"
